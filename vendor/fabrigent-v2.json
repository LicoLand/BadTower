{
  "artifactVersion": "fabrigent.bundle.v2",
  "digestAlgorithm": "sha256",
  "sources": {
    "contracts/v2/relay-envelope.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://licoarc.com/contracts/v2/relay-envelope.schema.json",
      "title": "Fabrigent opaque relay envelope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "envelopeId",
        "mailboxId",
        "ciphertext",
        "expiresAt"
      ],
      "properties": {
        "contractVersion": {
          "const": "fabrigent.relay.v2"
        },
        "envelopeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "mailboxId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policies/v2/relay-governance.json": {
      "policyVersion": "fabrigent.relay-governance.v2",
      "trustModel": "relay-is-untrusted",
      "requiredCapabilities": [
        "opaque-envelope-relay",
        "mailbox-lease",
        "quota",
        "acknowledgement",
        "expiry-cleanup"
      ],
      "forbiddenCapabilities": [
        "client-key-custody",
        "encryption",
        "decryption",
        "plaintext-inspection",
        "host-permission-authority",
        "client-runtime-coordination"
      ],
      "limits": {
        "maxCiphertextBytes": 1048576,
        "maxEnvelopeRetentionSeconds": 86400,
        "maxLeaseSeconds": 86400,
        "maxMailboxEnvelopes": 1000,
        "maxMailboxes": 1000,
        "maxRelayEnvelopes": 10000
      }
    },
    "conformance/v2/valid.json": [
      {
        "contractVersion": "fabrigent.relay.v2",
        "envelopeId": "env_000000000001",
        "mailboxId": "box_000000000001",
        "ciphertext": "synthetic-ciphertext",
        "expiresAt": "2030-01-01T00:00:00.000Z"
      }
    ],
    "conformance/v2/invalid.json": [
      {
        "name": "plaintext-field-is-forbidden",
        "value": {
          "contractVersion": "fabrigent.relay.v2",
          "envelopeId": "env_000000000002",
          "mailboxId": "box_000000000002",
          "ciphertext": "synthetic-ciphertext",
          "expiresAt": "2030-01-01T00:00:00.000Z",
          "plaintext": "forbidden"
        }
      },
      {
        "name": "ciphertext-is-required",
        "value": {
          "contractVersion": "fabrigent.relay.v2",
          "envelopeId": "env_000000000003",
          "mailboxId": "box_000000000003",
          "expiresAt": "2030-01-01T00:00:00.000Z"
        }
      }
    ]
  },
  "digest": "f1ecb7061131b3a4dee1af5004d663c407f2dfaee93a379a5262aad3fe110e3f"
}
